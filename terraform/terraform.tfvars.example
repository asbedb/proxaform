# Proxmox Provider Configuration
proxmox_api_url_with_port        = "https://192.168.1.100:8006/"
proxmox_privileged_user_username = "root@pam"
proxmox_privileged_user_password = "YourSecretProxmoxPassword"

# Node & Container Identification
proxmox_root_node_name          = "pve"
vm_id                           = 100
container_name                  = "ubuntu-lxc"
container_root_password         = "YourSecretContainerPassword"
authorised_ssh_key              = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ..."

# Network Settings
container_ipv4_address_cidr     = "192.168.1.50/24"
container_ipv4_gateway          = "192.168.1.1"
container_network_interface_name = "eth0"
container_network_bridge_name   = "vmbr0"

# OS Template Settings
proxmox_lxc_template_name       = "local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst"
proxmox_lxc_template_type       = "ubuntu"

# Storage Settings
disk_datastore_id               = "local-lvm"
disk_size                       = 8 # Size in GB

# Resource Allocation
container_cpu_cores              = 2
container_ram_mb                = 2048 # Dedicated RAM in MB (2 GB)
container_swap_mb               = 512  # Swap memory in MB